{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraEQ",
  "version": "0.1.0",
  "identifier": "com.auraeq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraEQ",
        "width": 1180,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Ecualizador de audio paramétrico"
  }
}
